{
  "name": "kopi-ruang-kita-backend",
  "version": "1.0.0",
  "description": "Backend API Server for Kopi Ruang Kita (Express.js + PostgreSQL)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:setup": "node database/migrate.js",
    "db:seed": "node database/migrate.js --seed-only",
    "db:reset": "node database/migrate.js --reset"
  },
  "keywords": [
    "express",
    "postgresql",
    "neon",
    "render",
    "rest-api",
    "coffee-shop"
  ],
  "author": "Orang 1: Database Architect & Full DevOps Lead",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
