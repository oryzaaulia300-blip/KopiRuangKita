# ==============================================================================
# KOPI RUANG KITA - ENVIRONMENT VARIABLES (.env.example)
# Disiapkan oleh: Orang 1 - Database Architect & Full DevOps Lead
# ==============================================================================

# Server Port
PORT=5000

# Environment Mode (development / production)
NODE_ENV=development

# Database Connection URL (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# Contoh Neon.tech: postgresql://neondb_owner:npg_xxx@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Contoh Supabase : postgresql://postgres:xxx@db.xxx.supabase.co:5432/postgres?sslmode=require
# Contoh Local    : postgresql://postgres:postgres@localhost:5432/kopiruangkita
DATABASE_URL=postgresql://postgres:password@localhost:5432/kopiruangkita

# JWT Secret Key (Gunakan string acak aman untuk signing token)
JWT_SECRET=super_secret_jwt_key_kopi_ruang_kita_2026_devops_lead

# JWT Expiration (contoh: 24h, 7d)
JWT_EXPIRES_IN=24h

# Allowed CORS Origins (Dipisahkan koma jika lebih dari satu)
# Masukkan URL Frontend Vercel saat deployment
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000,https://kopi-ruang-kita.vercel.app
