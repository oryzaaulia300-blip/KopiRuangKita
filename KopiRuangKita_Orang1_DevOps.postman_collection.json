    {
      "name": "3. Relational Schema & Transaction Test (orders -> order_items)",
      "description": "Pengujian transaksi ACID dan relasi Foreign Key antar tabel orders dan order_items.",
      "item": [
        {
          "name": "3.1 Transaksi Relasional (orders + order_items)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Dosen / QA Tester\",\n  \"table_number\": \"Meja 09\",\n  \"phone_number\": \"081234567890\",\n  \"payment_method\": \"QRIS\",\n  \"items\": [\n    {\n      \"menu_id\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"menu_id\": 9,\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Memeriksa eksekusi multi-table INSERT dengan Foreign Key constraint."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status response 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Transaksi berhasil dan kode order terbuat\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.order).to.have.property(\"order_code\");",
                  "    pm.collectionVariables.set(\"orderCode\", jsonData.order.order_code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3.2 Query Relasional Detail Order (JOIN items)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderCode}}"
              ]
            },
            "description": "Memeriksa integritas query JOIN antara header tabel orders dan detail order_items."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status response 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Data order memuat relasi items yang valid\", function () {",
                  "    var jsonData = pm.response.json();",
