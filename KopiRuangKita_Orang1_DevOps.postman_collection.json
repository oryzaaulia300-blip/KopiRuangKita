    {
      "name": "1. DevOps & Infrastructure Health",
      "description": "Pengujian infrastruktur serverless Vercel dan koneksi database pooler Supabase (Singapore).",
      "item": [
        {
          "name": "1.1 System Health & Supabase Pooler Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Memeriksa status hidup serverless Express di Vercel dan konektivitas live ke PostgreSQL Supabase."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status response 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Server status is OK\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"OK\");",
                  "});",
                  "",
                  "pm.test(\"PostgreSQL Database is CONNECTED\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.database.status).to.eql(\"CONNECTED\");",
                  "});",
                  "",
                  "pm.test(\"Response time dibawah 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
